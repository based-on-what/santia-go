# .env.example - copia como .env para desarrollo local. Nunca commitear .env.

# Puerto HTTP de api.py. Railway lo inyecta; en local se usa 8000 si falta.
PORT=

# Solo ibus-server.py (proxy local opcional): segundos que reutiliza la respuesta
# de un paradero. Default: 20. La app en Railway ya no usa el proxy.
IBUS_CACHE_TTL=
